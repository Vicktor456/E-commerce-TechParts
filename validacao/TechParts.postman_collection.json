  "item": [
    {
      "name": "Catálogo público e paginação",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/catalogo/produtos?pagina=1&limite=9"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Página populada\", () => pm.expect(pm.response.json().items).to.have.lengthOf(9));"
            ]
          }
        }
      ]
    },
    {
      "name": "Filtro AM5 + DDR5",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/catalogo/produtos?categoria=placa-mae&especificacao=soquete:AM5&especificacao=tipo_memoria:DDR5"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Filtros combinados\", () => { const r=pm.response.json(); pm.expect(r.total).to.be.above(0); r.items.forEach(p => { pm.expect(p.specs.Soquete).to.eql(\"AM5\"); pm.expect(p.specs[\"Tipo de memória\"]).to.eql(\"DDR5\"); }); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Carrinho exige sessão",
