{
  "info": {
    "name": "TechParts — Validação da PoC",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5173"
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "customerEmail",
      "value": ""
    },
    {
      "key": "customerPassword",
      "value": ""
    }
