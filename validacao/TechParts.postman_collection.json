          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Perfil cliente\", () => pm.expect(pm.response.json().role).to.eql(\"client\"));"
            ]
          }
        }
      ]
